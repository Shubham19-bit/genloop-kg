# Copy to .env and fill in. Never commit .env.
# The submitted results were produced with a LOCAL model: Ollama + qwen3.5:9b.
# data/llm_cache/ holds every response keyed by provider+model+prompt, so with these defaults
# `python -m src.cli build` + `python -m src.cli eval` replay the exact run without calling any model.
SEC_USER_AGENT=Your Name your.email@example.com
LLM_PROVIDER=ollama            # ollama | gemini | groq
OLLAMA_MODEL=qwen3.5:9b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen # free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
